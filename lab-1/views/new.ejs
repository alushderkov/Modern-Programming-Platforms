<%- include('partials/header') %>

<section class="page-head">
  <div>
    <p class="crumb"><a href="/">Задачи</a> / новая</p>
    <h1>Новая задача</h1>
  </div>
</section>

<% if (error) { %>
  <p class="banner banner-err"><%= error %></p>
<% } %>

<form class="panel form" method="post" action="/tasks">
  <label>
    Название
    <input type="text" name="title" maxlength="120" required value="<%= values.title || '' %>" />
  </label>
  <label>
    Описание
    <textarea name="description" rows="4"><%= values.description || '' %></textarea>
  </label>
  <div class="form-row">
    <label>
      Статус
      <select name="status">
        <option value="pending" <%= values.status === 'pending' ? 'selected' : '' %>>Ожидает</option>
        <option value="in_progress" <%= values.status === 'in_progress' ? 'selected' : '' %>>В работе</option>
        <option value="done" <%= values.status === 'done' ? 'selected' : '' %>>Выполнена</option>
      </select>
    </label>
    <label>
      Ожидаемая дата завершения
      <input type="date" name="dueDate" value="<%= values.dueDate || '' %>" />
    </label>
  </div>
  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Создать</button>
    <a class="btn btn-ghost" href="/">Отмена</a>
  </div>
</form>

<%- include('partials/footer') %>
